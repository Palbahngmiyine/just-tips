{
  "name": "just-tips",
  "packageManager": "yarn@4.9.2",
  "devDependencies": {
    "subux": "https://github.com/Palbahngmiyine/subux/releases/download/v0.3.0/subux-0.3.0.tgz"
  },
  "scripts": {
    "dev": "yarn build && yarn preview",
    "build": "rm -rf dist && subux build -i . -o dist",
    "check": "subux check -i .",
    "preview": "yarn dlx wrangler pages dev dist"
  }
}
